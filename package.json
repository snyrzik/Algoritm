  "private": true,
  "type": "module",
  "scripts": {
    "start": "node tools/start.mjs",
    "dev": "node tools/start.mjs --dev",
    "build": "tsc --noEmit && vite build",
    "prepare:course": "node tools/python.mjs tools/build_course.py",
    "prepare:theory": "node tools/python.mjs tools/prepare_lecture01.py",
    "prepare:day01": "node tools/python.mjs tools/prepare_lecture01.py",
    "test": "node tools/python.mjs -m unittest discover -s tests -v",
    "test:contracts": "node tools/python.mjs tools/check_contracts.py",
    "test:manual-mains": "node tools/python.mjs tools/check_manual_mains.py",
    "test:browser": "node tools/browser_check.mjs",
    "test:platform-browser": "node tools/browser_platform_check.mjs",
